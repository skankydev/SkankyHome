{
    "name": "simon/skanky-home",
    "description": "la gestion de ma maison",
    "license": "MIT",
    "autoload": {
         "psr-4": {
            "App\\": "src/App"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTest\\":    "tests/AppTest"
        }
    },
    "authors": [
        {
            "name": "Skankydev",
            "email": "simon.schenck@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "skankydev/framework": "^0.1",
        "mongodb/mongodb": "^2.1",
        "php-mqtt/client": "^2.3",
        "league/commonmark": "^2.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage-pretty": "phpunit --coverage-html build/coverage"
    }
}
